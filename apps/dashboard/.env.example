# Local Development Environment (Supabase CLI)
# Run `supabase status` to get your ANON_KEY and SERVICE_ROLE_KEY

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_here

# App Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
DASHBOARD_URL=http://localhost:3000

# Security
EXTENSION_KEY=dev-extension-key-123

# AI Keys (Optional for local dev unless testing AI features)
GEMINI_API_KEY=
CONTEXT7_API_KEY=
