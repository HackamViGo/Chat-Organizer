{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "composite": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@brainbox/shared": [
        "../../packages/shared/src"
      ],
      "@brainbox/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "types": [
      "chrome",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}